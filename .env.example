# Host path of the project to work with (forward slashes are fine on Windows).
PROJECT_PATH=C:/Users/you/source/repos/myproject

# Optional: separate docs project (e.g. a Hugo site) for the same product.
# DOCS_PATH=C:/Users/you/source/repos/myproject-docs

# CHAT_MODEL=qwen2.5:7b
# EMBED_MODEL=bge-m3

# Set to true once to rebuild the docs index (e.g. after the docs changed).
# REINDEX=false

# Language of review reports.
# REVIEW_LANGUAGE=English

# Reviews of more files than this stop with a warning before any model call (override per run with --max-files N).
# REVIEW_MAX_FILES=25

# NVIDIA GPU for Ollama (Windows with Docker Desktop, or Linux with the NVIDIA Container Toolkit).
# Without these lines Ollama runs on the CPU, which works everywhere but is slower.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,compose.gpu.yaml

# Use an Ollama running outside Docker instead of the bundled one. On a Mac this is the only way to
# get the Apple GPU: install Ollama natively, then run yocode with --no-deps.
# OLLAMA_URL=http://host.docker.internal:11434
