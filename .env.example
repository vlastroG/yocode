# Host path of the project to work with (forward slashes are fine on Windows).
PROJECT_PATH=C:/Users/you/source/repos/myproject

# Optional: separate docs project (e.g. a Hugo site) for the same product.
# DOCS_PATH=C:/Users/you/source/repos/myproject-docs

# DeepSeek API key (required). Prompts, including file contents the tools read, go to DeepSeek.
DEEPSEEK_API_KEY=sk-...

# DeepSeek chat model: deepseek-flash (default) or deepseek-v4-pro.
# CHAT_MODEL=deepseek-flash

# Local Ollama embedding model for the docs index.
# EMBED_MODEL=bge-m3

# Optional TypeSafe key: Jev then picks the relevant docs excerpts and reads plain text typed while a plan
# is pending as a correction, approval, cancel or question. Docs excerpts and those messages go to TypeSafe.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0

# How task steps run: single (one conversation, access of the plan's widest step)
# or subagents (one fresh agent per step, with that step's access).
# TASK_MODE=single

# Author and committer of commits made by tasks.
# GIT_USER_NAME=yocode
# GIT_USER_EMAIL=yocode@localhost

# Set to true once to rebuild the docs index (e.g. after the docs changed).
# REINDEX=false

# Language of review reports.
# REVIEW_LANGUAGE=English

# Reviews of more files than this stop with a warning before any model call (override per run with --max-files N).
# REVIEW_MAX_FILES=25

# NVIDIA GPU for the embedding Ollama (Windows with Docker Desktop, or Linux with the NVIDIA Container Toolkit).
# Without these lines embeddings run on the CPU, which only slows down building the docs index.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,compose.gpu.yaml

# Use an Ollama running outside Docker for embeddings instead of the bundled one, then run yocode with --no-deps.
# OLLAMA_URL=http://host.docker.internal:11434
